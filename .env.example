# Copy to `.env` (never commit it) and fill in.

# Production (PythonAnywhere): keep DEBUG=0. Local development: DEBUG=1.
DEBUG=0

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma separated host names.
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Optional: WhatsApp Business Cloud API (leave empty for dry-run mode)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
