# Copy to `.env` (never commit it) and fill in.

# Production (PythonAnywhere): keep DEBUG=0. Local development: DEBUG=1.
DEBUG=0

# Optional. If you leave this out, the app creates a random key once and saves it in `.secret_key`.
# SECRET_KEY=

# Comma separated host names.
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Web frontend origins allowed to call the API (exact URLs, comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://transcendent-liger-58da43.netlify.app

# Optional: WhatsApp Business Cloud API (leave empty for dry-run mode)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
